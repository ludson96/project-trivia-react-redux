{
  "name": "trivia-react-redux",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=16"
  },
  "dependencies": {
    "@redux-devtools/extension": "3.2.2",
    "axios": "^1.20.0",
    "crypto-js": "^4.1.1",
    "lucide-react": "^1.47.0",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-redux": "^8.0.2",
    "react-router-dom": "^5.3.3",
    "react-scripts": "5.0.1",
    "redux": "^4.2.0",
    "redux-thunk": "^2.4.1"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^12.1.5",
    "@testing-library/user-event": "^13.5.0",
    "@types/crypto-js": "^4.2.2",
    "@types/react": "^17.0.93",
    "@types/react-dom": "^17.0.26",
    "@types/react-router-dom": "^5.3.3",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "jest-localstorage-mock": "2.4.22",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "^4.9.5",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "jest": {
    "coveragePathIgnorePatterns": [
      "index.js",
      "serviceWorker.js",
      "src/services/*",
      "src/pages/Config.js",
      "src/redux/*",
      "src/store/*",
      "src/utils/*",
      "src/tests/helpers/*"
    ]
  }
}
